{
  "description": "Injects the scope rules on every user message",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/response-rules.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
